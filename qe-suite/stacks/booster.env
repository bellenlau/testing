# Leonardo Booster NVHPC/HPC-X CUDA 12 stack.
STACK_NAME=booster-nvhpc-hpcx-cuda12-25.11
MODULES=(
	"cmake"
	"intel-oneapi-mkl/2024.0.0"
	"/leonardo/prod/spack/06/install/0.22/linux-rhel8-icelake/gcc-8.5.0/nvhpc-25.11-ayzlbce6ohpmv72ncfv4ogitmppp2usq/modulefiles/nvhpc-hpcx-cuda12/25.11"
)
CMAKE_ARGS=(
	"-DCMAKE_C_COMPILER=nvc"
	"-DCMAKE_Fortran_COMPILER=mpif90"
	"-DQE_GPU=cuda;openacc"
	"-DQE_ENABLE_OPENMP=ON"
	"-DNVFORTRAN_CUDA_CC=80"
	"-DNVFORTRAN_CUDA_VERSION=12.9"
	"-DQE_CLOCK_SECONDS=ON"
	"-DQE_ENABLE_MPI_GPU_AWARE=ON"
)
TEST_LAUNCHER=booster
SLURM_PARTITION=boost_usr_prod
SLURM_QOS=boost_qos_dbg
SLURM_ACCOUNT=cin_staff
SLURM_TIME=00:30:00
SLURM_NODES=1
SLURM_TASKS_PER_NODE=4
SLURM_CPUS_PER_TASK=8
SLURM_GRES=gpu:4
OMP_THREADS=8