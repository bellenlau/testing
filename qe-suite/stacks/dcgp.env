# Leonardo DCGP Intel oneAPI stack.
STACK_NAME=dcgp-cpu
MODULES=(
	"intel-oneapi-mpi/2021.12.1"
	"intel-oneapi-mkl/2024.0.0--intel-oneapi-mpi--2021.12.1"
	"intel-oneapi-compilers/2024.1.0"
)
CMAKE_ARGS=(
	"-DQE_ENABLE_MPI=ON"
	"-DQE_ENABLE_OPENMP=ON"
	"-DCMAKE_C_COMPILER=icx"
	"-DCMAKE_C_FLAGS:STRING=\"-xCORE-AVX512\""
	"-DCMAKE_Fortran_COMPILER=mpiifort"
	"-DCMAKE_Fortran_FLAGS:STRING=\"-fc=ifx -xCORE-AVX512\""
	"-DQE_ENABLE_SCALAPACK=ON"
	"-DQE_FFTW_VENDOR=Intel_FFTW3"
)
TEST_LAUNCHER=dcgp
SLURM_PARTITION=dcgp_usr_prod
SLURM_NODES=1
SLURM_TASKS_PER_NODE=4
SLURM_CPUS_PER_TASK=8
OMP_THREADS=8